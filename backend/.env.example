# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production example)
# DATABASE_URL="postgresql://user:password@host:5432/objectar"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── AR Generation Provider ─────────────────────────────────────────────────
# Supported: tripo3d | meshy | unconfigured
# Set to "unconfigured" until you have a provider API key.
# When unconfigured, AR job creation returns HTTP 503 with setup instructions.
AR_PROVIDER=unconfigured
AR_PROVIDER_API_KEY=

# ─── Subject Segmentation Provider ──────────────────────────────────────────
# Supported: rembg | sam | passthrough | unconfigured
# "passthrough" — use when your AR_PROVIDER performs segmentation natively.
# "rembg"       — remove.bg API  https://www.remove.bg/api
# "sam"         — Segment Anything Model endpoint (self-hosted or API)
# When unconfigured, segmentation is skipped and user is warned.
SEGMENTATION_PROVIDER=unconfigured
SEGMENTATION_API_KEY=
SEGMENTATION_CONFIDENCE_THRESHOLD=0.70

# ─── Storage ─────────────────────────────────────────────────────────────────
# Supported: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# AWS / Cloudflare R2 (if STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEB_APP_PRICE_ID=
STRIPE_API_PLAN_PRICE_ID=

# ─── Private Internal First-Party Credential ────────────────────────────────
# Used by the separate Universal Digital Menu SaaS to access this AR API.
# Never expose to clients, browsers, or external users.
INTERNAL_AR_SERVICE_SECRET=change-this-to-a-secure-random-token-in-production

# ─── Mock Provider ───────────────────────────────────────────────────────────
# NEVER enable in production. Only for automated test suites.
# ALLOW_MOCK_PROVIDER=true
