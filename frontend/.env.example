# ─── Frontend Environment Configuration ─────────────────────────────────────
# For Vercel: Set these in the Vercel Project Settings -> Environment Variables.
# For Local Dev: Copy this file to .env.local and adjust.
# NEVER put secrets in this file — all VITE_* variables are bundled into browser code.

# Backend API Base URL (Do NOT include a trailing slash)
# Local development default:
# VITE_API_BASE_URL=http://localhost:3001
#
# Production (Render backend URL):
VITE_API_BASE_URL=https://your-backend-name.onrender.com
